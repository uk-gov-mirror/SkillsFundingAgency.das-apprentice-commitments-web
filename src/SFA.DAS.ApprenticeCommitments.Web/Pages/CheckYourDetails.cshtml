@page
@model SFA.DAS.ApprenticeCommitments.Web.Pages.CheckYourDetails
@{
    ViewData["Title"] = "Check your details";
}

<main role="main" id="content" class="govuk-main-wrapper">
    <span id="Top"></span>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="gem-c-heading govuk-!-margin-bottom-8">
                <h1 class="gem-c-heading__text govuk-heading-xl">
                    We could not find your apprenticeship
                </h1>
            </div>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="article-container group govuk-grid-column-two-thirds">
            <p class="govuk-body">
                You can only use this service if you're an apprentice, not if you're doing any other type of course.
            </p>
            <p class="govuk-body">
                If you're an apprentice, check the name of your course and your training provider - this information is in the first email we sent to you about your apprenticeship.
            </p>
            <p class="govuk-body">
                If this is right, contact your training provider and make sure they have your correct name and date of birth. If anything's wrong your provider will need to correct this before you can access Your Apprenticeship.
            </p>
            <p class="govuk-body">
                If you need your unique learner number, your training provider will know it. It might also be printed on your certificates or exam results.
            </p>
        </div>
    </div>
</main>