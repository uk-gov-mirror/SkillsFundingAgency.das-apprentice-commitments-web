@page "/apprenticeships/{apprenticeshipId}/checkyourapprenticeshipdetails"
@using SFA.DAS.ApprenticeCommitments.Web.Helpers
@model SFA.DAS.ApprenticeCommitments.Web.Pages.Apprenticeships.YourApprenticeshipDetails
@{
    ViewData["Title"] = "Check your apprenticeship details";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">Check your apprenticeship details</h1>

        <dl class="govuk-summary-list govuk-!-margin-bottom-9">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    Full name
                </dt>
                <dd class="govuk-summary-list__value govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    @Model.FirstName @Model.LastName
                </dd>
            </div>

            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    Current employer
                </dt>
                <dd class="govuk-summary-list__value govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    @Model.EmployerName
                </dd>
            </div>

            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    Training provider
                </dt>
                <dd class="govuk-summary-list__value govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    @Model.TrainingProviderName
                </dd>
            </div>

            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    Apprenticeship
                </dt>
                <dd class="govuk-summary-list__value govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    @Model.CourseName
                </dd>
            </div>

            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    Level
                </dt>
                <dd class="govuk-summary-list__value govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    @Model.CourseLevel
                </dd>
            </div>

            @if (Utilities.IsValidApprenticeshipType(Model.ApprenticeshipType))
            {
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                        Type
                    </dt>
                    <dd class="govuk-summary-list__value govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                        @Utilities.GetApprenticeshipTypeDescription(Model.ApprenticeshipType)
                    </dd>
                </div>
            }

            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    Planned training start date
                </dt>
                <dd class="govuk-summary-list__value govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    @Model.PlannedStartDate.ToString("MMMM yyyy")
                </dd>
            </div>

            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    Planned training end date
                </dt>
                <dd class="govuk-summary-list__value govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                    @Model.PlannedEndDate.ToString("MMMM yyyy")
                </dd>
            </div>
          
            @if (Model.Rpl.HasValue && Model.Rpl.Value)
            {
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                        Reduction in apprenticeship duration due to your prior learning
                    </dt>
                    <dd class="govuk-summary-list__value govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                        @Model.DurationReducedBy weeks
                    </dd>
                </div>

                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                        Training reduction due to your prior learning
                    </dt>
                    <dd class="govuk-summary-list__value govuk-!-width-one-half govuk-!-padding-top-4 govuk-!-padding-bottom-4">
                        @Model.DurationReducedByHours hours
                    </dd>
                </div>
            }

        </dl>

        <div class="govuk-inset-text">
            <p class="govuk-body govuk-!-font-weight-bold">
                Are any of your details wrong?
            </p>
            <p class="govuk-body">
                If your training provider is wrong, tell your contact at @Model.EmployerName. If your employer or any other details are wrong, tell your contact at @Model.TrainingProviderName. They'll correct them and we'll email you when it's been done.
            </p>
        </div>

        <form method="post">
            <div class="govuk-form-group">
                <div class="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input" id="accept-terms" name="accept-terms" type="checkbox" value="accepted">
                        <label class="govuk-label govuk-checkboxes__label" for="accept-terms">
                            I confirm that my apprenticeship details are correct
                        </label>
                    </div>
                </div>
            </div>

            <button type="submit" class="govuk-button" data-module="govuk-button" asp-page-handler="Confirm" id="continue-button" disabled>
                Continue
            </button>
        </form>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const checkbox = document.getElementById('accept-terms');
                const button = document.getElementById('continue-button');

                button.disabled = true;
                checkbox.addEventListener('change', function() {
                    button.disabled = !checkbox.checked;
                });
            });
        </script>
    </div>
</div>