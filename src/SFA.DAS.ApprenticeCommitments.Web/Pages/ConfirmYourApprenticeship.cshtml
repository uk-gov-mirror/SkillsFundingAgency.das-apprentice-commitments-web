@page
@model SFA.DAS.ApprenticeCommitments.Web.Pages.ConfirmYourApprenticeshipModel
@{
}

<h2>Confirm Your Apprenticeship</h2>

<form method="post">
    <input type="hidden" asp-for="@Model.ApprenticeId" />
    <input type="hidden" asp-for="@Model.ApprenticeshipId" />
    <input type="hidden" asp-for="@Model.RevisionId" />

<table class="govuk-table data-table">
    <caption class="govuk-table__caption govuk-table__caption--m">Training details</caption>
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">Delivery model</th>
            <td class="govuk-table__cell">@Model.FullName</td>
        </tr>
        <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">Employer</th>
            <td class="govuk-table__cell">@Model.EmployerName</td>
        </tr>
        <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">Training Provider</th>
            <td class="govuk-table__cell">@Model.TrainingProviderName</td>
        </tr>
        <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">Apprenticeship</th>
            <td class="govuk-table__cell">@Model.CourseName</td>
        </tr>
        <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">Level</th>
            <td class="govuk-table__cell">@Model.Level</td>
        </tr>        
        @* <tr asp-show="Model.CourseOption != null" class="govuk-table__row">
            <th scope="row" class="govuk-table__header">Option</th>
            <td class="govuk-table__cell">@Model.CourseOption</td>
        </tr> *@
        <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">Planned training start date</th>
            <td class="govuk-table__cell">@Model.StartDate</td>
        </tr>
        <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">Planned training end date</th>
            <td class="govuk-table__cell">@Model.EndDate</td>
        </tr>        
    </tbody>
</table>

    <div class="govuk-button-group">
        <button class="govuk-button" type="submit">Continue</button>
    </div>
</form>