@page
@model SFA.DAS.ApprenticeCommitments.Web.Pages.AccountNotFoundModel
@{
    Layout = "_Layout";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govyk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                We could not find your apprenticeship
            </h1>
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-third">
            <p class="govuk-p">
                You can only use this service if you're an apprentice, not if you're doing any other type of course
            </p>
            <p>
                If you're an apprentice, check the name of your course and your training provider - this information is in the first
                email we sent to you about your apprenticeship
            </p>
            <p>
                If this is right, contact your training provider and make sure they have your correct name and date of birth. If
                anything's wrong your provider will need to correct this before you can access Your Apprenticeship
            </p>
            <p>
                If you need your unique learner number, your training provider will know it. It might also be printed on your
                certificates or exam results.
            </p>
        </div>
    </div>
</div>